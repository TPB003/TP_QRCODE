{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tp-qr",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "inspector": false
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tp-qr-db",
      "migrations_dir": "../../infra/cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "tp-qr-assets-local"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "AUTH_DELIVERY_MODE": "dev",
    "AUTH_TEST_CODE": "123456",
    "AUTH_ALLOWED_EMAILS": "*"
  },
  "env": {},
  "triggers": {
    "crons": ["15 3 * * *"]
  }
}
