{
  "name": "tp-qr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n client,worker -c blue,green \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc --port 8787",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:local": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:browser",
    "check:all": "npm run check:local && npm run test:security && npm run check:opensource",
    "check:opensource": "node scripts/check-open-source.mjs",
    "test:security": "vitest run tests/security",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:local": "wrangler d1 migrations apply tp-qr-db --local --config apps/worker/wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute tp-qr-db --local --config apps/worker/wrangler.jsonc --file=infra/cloudflare/seed/local.sql",
    "db:migrate:remote": "wrangler d1 migrations apply tp-qr-db --remote --config apps/worker/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy --config apps/worker/wrangler.jsonc"
  },
  "dependencies": {
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@dnd-kit/utilities": "latest",
    "@hono/zod-validator": "latest",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "latest",
    "@tanstack/react-query": "latest",
    "hono": "latest",
    "jszip": "latest",
    "lucide-react": "latest",
    "papaparse": "latest",
    "qr-code-styling": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^26.1.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
